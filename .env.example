# Substitua as senhas. Use caracteres alfanuméricos no POSTGRES_PASSWORD para a cadeia de conexão.
POSTGRES_PASSWORD=
ADMIN_PASSWORD=
MEDIA_DIRECTORY=./midia
IMOVEIS_PORT=5086
ASPNETCORE_ENVIRONMENT=Development

# Opcional. Use o código do país, DDD e número, somente dígitos.
VITRINE_WHATSAPP=

# Cadastro multiempresa opcional. Use uma chave aleatória de pelo menos 32 caracteres.
SAAS_ENABLE_MULTI_TENANT=false
SAAS_LEGACY_HOSTNAMES=
SAAS_PLATFORM_ADMIN_KEY=

# URL HTTPS da aplicação que atende os catálogos externos. Exemplo https://imoveis.exemplo.com.br
SAAS_PUBLIC_CATALOG_BASE_URL=
